{
  "name": "Anki Inspector — .apkg Viewer",
  "short_name": "Anki Inspector",
  "description": "Inspect Anki .apkg files entirely on-device. WebAssembly SQLite parsing, zero uploads.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#10131a",
  "theme_color": "#10131a",
  "categories": ["education", "utilities", "productivity"],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://optimusprimenightfury.github.io/Anki-PWA/manifest.json"
    }
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open .apkg file",
      "short_name": "Open file",
      "description": "Pick an Anki package to inspect",
      "url": "./#open",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "https://optimusprimenightfury.github.io/Anki-PWA/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            ".apkg",
            ".colpkg",
            "application/octet-stream",
            "application/zip",
            "application/apkg",
            "application/x-apkg",
            "*/*"
          ]
        }
      ]
    }
  }
}
